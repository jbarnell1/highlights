# Copy to .env next to compose.yaml and fill in the two keys. Never commit the real file.

# Immich > your avatar > Account Settings > API Keys > New API Key (permission: all)
IMMICH_API_KEY=
# How the container reaches Immich. With compose.yaml as shipped, Immich's own network is joined
# and its server is http://immich_server:2283.
IMMICH_URL=http://immich_server:2283
# The address people open Immich at, used for links from the app. Empty means IMMICH_URL.
IMMICH_PUBLIC_URL=

# Claude Code on a Claude subscription, not the paid API: run `claude setup-token` on any
# computer, sign in, and paste the token it prints. It is valid for a year.
CLAUDE_CODE_OAUTH_TOKEN=
# Model alias passed to Claude Code.
HL_MODEL=opus

# Folder on this machine that Immich mounts as /data (its UPLOAD_LOCATION). Mounted read-only
# so clips are read off disk instead of downloaded. Leave the default if Immich runs elsewhere.
IMMICH_LIBRARY=./immich-library-not-mounted
# Where Highlights keeps its database, renders and caches.
HL_DATA=./data

# Optional. Home is inferred from where most photos are taken; set these to pin it.
HL_HOME_LAT=
HL_HOME_LON=
# A trip is a run of photos more than this far from home.
HL_AWAY_KM=80

# Raw clips can only be moved to Immich's trash after the Immich library has an offsite backup.
HL_CLEANUP_ENABLED=false

# The path a reverse proxy serves the app under. "/" if it gets its own hostname.
HL_BASE_PATH=/highlights

# Group that owns /dev/dri/renderD128 on the host, so the container may use Quick Sync:
#   getent group render | cut -d: -f3
RENDER_GID=
